{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx pnpm@10.33.0 install --frozen-lockfile",
  "buildCommand": "npx expo export -p web && node scripts/postexport.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/skill/:id", "destination": "/skill/:id.html" },
    { "source": "/grade/:grade", "destination": "/grade/:grade.html" },
    { "source": "/course/:id", "destination": "/course/:id/index.html" },
    { "source": "/course/:id/topic/:index", "destination": "/course/:id/topic/:index.html" },
    { "source": "/he/:division", "destination": "/he/:division/index.html" },
    { "source": "/he/:division/:field", "destination": "/he/:division/:field.html" }
  ]
}
